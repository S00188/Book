# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring

# Server porti
PORT=3000

# Ishlab chiqarish rejimi: production qilib qo'ysangiz, qat'iy CORS + admin tekshiruvi faollashadi
# NODE_ENV=production

# BotFather bergan bot tokeni (Telegram initData'ni tekshirish uchun MAJBURIY)
# Masalan: 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_TOKEN=

# Admin: Telegram user ID (tavsiya etilgan usul).
# Sizning Telegram ID'ingizni bot orqali bilib oling (masalan /myid yoki @userinfobot).
# Bu qiymat o'rnatilgan bo'lsa, faqat shu user /admin va admin API'larga kira oladi.
# ADMIN_ID=123456789

# Admin: muqobil maxfiy kalit (X-Admin-Key header orqali yuboriladi).
# DIQQAT: standart qiymat YO'Q. Production'da majburan o'rnatilishi kerak,
# aks holda admin endpointlari 503 (CONFIG_ERROR) qaytaradi.
ADMIN_KEY=

# Webapp joylashgan HTTPS manzil (bot.js shu manzilni /start tugmasida ishlatadi)
# Masalan: https://sizning-domen.com  yoki https://xxxx.trycloudflare.com
WEBAPP_URL=

# Kanal ID (kanal import uchun). Admin shu kanalda video + caption yuborganda
# bot avtomatik film yaratadi. Format: @kanalusername yoki -100xxxxxxxxxx
# Masalan: CHANNEL_ID=@kinobot_channel  yoki  CHANNEL_ID=-1001234567890
# CHANNEL_ID=

# CORS ruxsat berilgan originlar (vergul bilan ajratiladi).
# Production'da to'ldirilishi kerak, aks holda faqat o'z originiga ruxsat beriladi.
# Masalan: ALLOWED_ORIGINS=https://sizning-domen.com,https://xxxx.trycloudflare.com
# ALLOWED_ORIGINS=

# ---- Video storage ----
# Ikki rejim:
#
#   LOKAL (standart, Cloudflare shart emas):
#   R2 key'lari bo'sh bo'lsa, video fayllar kompyuterdagi
#   `backend/data/videos/{filmId}/{quality}.mp4` papkasiga saqlanadi.
#   Upload ham, player ham shu holda ishlaydi. Test uchun shu rejimni ishlating.
#
#   CLOUDFLARE R2:
#   Quyidagi 4 qiymat to'ldirilsa, video fayllar R2'ga saqlanadi.
# 1) Cloudflare dashboards -> R2 -> bucket yarating (masalan "kinobot-videos", PRIVATE).
# 2) R2 -> Manage R2 API Tokens -> token yarating:
#    - Permission: Object Read & Write (faqat shu bucket uchun)
#    - Access Key ID va Secret Access Key'larni saqlang (faqat bir marta ko'rsatiladi!)
# 3) Quyidagilarni to'ldiring:
CLOUDFLARE_ACCOUNT_ID=

# Kali lokal video saqlash papkasi (R2 o'rniga alternativ yoki fallback).
# R2 sozlanmaganida video fayllar shu papkaga saqlanadi va HTTP Range bilan
# xizmat qilinadi. Har bir film alohida papkada: {papka}/{filmId}/{quality}.mp4
LOCAL_VIDEOS_DIR=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
